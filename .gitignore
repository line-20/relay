# Local Relay briefs — dogfooding scratch, not part of the plugin
relay/briefs/
relay/roadmap/

# Harvest write-ahead log — transient per-lap staging consumed by `apply`; only the
# checkpoint it produces is durable, so the WAL never belongs in git.
relay/harvest/*/results/

# Maintainer usage-analysis (/reflect) — local cross-project data, never committed
reflect.repos
reflect/

# Git worktrees created by Claude Code sessions (never part of the repo)
.claude/worktrees/

# Python bytecode from scripts/tests
__pycache__/
*.pyc
